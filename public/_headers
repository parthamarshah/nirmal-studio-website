# Cloudflare Pages response headers.
# Generated images carry a content hash in their file name (scripts/build-content.mjs),
# so a changed image always gets a new URL — safe for browsers to cache for a year.
/_media/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts (v1 Phase 1d). The Google Fonts version number is baked into
# each file name (fraunces-v38-*, syne-v24-*), so updating a font means a new URL —
# same reasoning as the hashed images above, safe to cache for a year.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The editing backend. robots.txt and the page's own meta tag cover the HTML; this
# covers the JavaScript and CSS too, which a meta tag cannot speak for. Preview
# deployments get an automatic noindex from Cloudflare but production does NOT, so this
# is the line that matters on nirmalstudio.com. no-store because an admin screen should
# never sit in a shared cache or survive in the back/forward cache after signing out.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: same-origin
  X-Frame-Options: DENY
